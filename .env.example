# Required only for live OpenAI runs. Never commit a real key.
OPENAI_API_KEY=

# Cost-sensitive default for repeatable evaluation runs.
KERF_DEFAULT_MODEL=gpt-5.6-luna
KERF_REASONING_EFFORT=low
KERF_MAX_OUTPUT_TOKENS=900

# Optional. Prices are USD per 1 million tokens and can be updated without code changes.
KERF_INPUT_PRICE_PER_MILLION=0.20
KERF_OUTPUT_PRICE_PER_MILLION=1.20

